      <% if (settings.instagram) { %><a href="<%= settings.instagram %>" rel="noopener" target="_blank">Instagram</a><% } %>
    </div>
  </div>
  <div class="wrap legal"><span>© <%= new Date().getFullYear() %> ASAD – Association des Animaux en Détresse</span><a href="/admin">Espace bénévoles</a></div>
