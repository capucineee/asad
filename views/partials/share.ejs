<% const _url = absUrl(path); const _txt = typeof shareText !== 'undefined' ? shareText : "À découvrir sur le site de l'ASAD"; %>
<div class="share">
  <span class="share-label">Partager <%= typeof shareWhat !== 'undefined' ? shareWhat : '' %> :</span>
  <a class="share-btn fb" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(_url) %>" target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.8l-.4 2.9h-2.4v7A10 10 0 0 0 22 12z"/></svg>
    Facebook
  </a>
  <a class="share-btn wa" href="https://wa.me/?text=<%= encodeURIComponent(_txt + ' — ' + _url) %>" target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm5.8 14.1c-.2.7-1.4 1.3-2 1.4-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5.1-4.5-.1-.2-1.2-1.5-1.2-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.3 0 .5l-.4.5-.3.3c-.1.1-.2.3 0 .5.2.3.8 1.3 1.7 2.1 1.1 1 2 1.3 2.3 1.4.2.1.4.1.5-.1l.8-.9c.2-.2.3-.2.5-.1l2 .9c.2.1.4.2.4.3.1.1.1.6-.1 1.3z"/></svg>
    WhatsApp
  </a>
  <button type="button" class="share-btn copy" data-copy="<%= _url %>">🔗 Copier le lien</button>
</div>
