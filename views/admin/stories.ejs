<%- include('../partials/admin-header') %>
<div class="admin-head"><h1>Histoires d'adoption</h1><a class="btn" href="/admin/histoires/nouveau">+ Raconter une adoption</a></div>
<p class="lead">Ces histoires apparaissent dans la rubrique « Adoptés » du site.</p>
<% if (!stories.length) { %><p class="empty">Aucune histoire pour le moment. Commencez par celle d'un animal récemment adopté !</p><% } %>
<div class="rows">
<% stories.forEach(st => { %>
  <div class="row <%= st.pending ? 'row-pending' : '' %>">
    <div class="row-thumb"><% if (st.photo) { %><img src="/uploads/<%= st.photo %>" alt=""><% } else { %><div class="ph"><%- include('../partials/paw') %></div><% } %></div>
    <div class="row-main"><strong><%= st.pet_name %> — <%= st.title %></strong><span class="muted"><%= st.adopter ? 'Adopté par ' + st.adopter + ' · ' : '' %><%= fdate(st.created_at) %></span>
      <% if (st.pending) { %><span class="badge badge-distress inline">Envoyée par un adoptant · à valider</span><% } else if (!st.published) { %><span class="badge badge-soft inline">Brouillon</span><% } %></div>
    <div class="row-actions">
      <% if (!st.published) { %><form method="post" action="/admin/histoires/<%= st.id %>/valider"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm">Publier</button></form><% } %>
      <% if (st.published) { %><a class="btn btn-sm btn-ghost" href="/histoires/<%= st.id %>" target="_blank">Voir</a><% } %>
      <a class="btn btn-sm btn-ghost" href="/admin/histoires/<%= st.id %>">Modifier</a>
      <form method="post" action="/admin/histoires/<%= st.id %>/supprimer" data-confirm="Supprimer cette histoire définitivement ?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-danger">Supprimer</button></form>
    </div>
  </div>
<% }) %>
</div>
<%- include('../partials/admin-footer') %>
