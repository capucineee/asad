<%- include('../partials/admin-header') %>
<div class="admin-head"><h1>Les articles</h1><a class="btn" href="/admin/articles/nouveau">+ Écrire un article</a></div>
<% if (!posts.length) { %><p class="empty">Aucun article. Un premier conseil sur les bons réflexes ?</p><% } %>
<div class="rows">
<% posts.forEach(p => { %>
  <div class="row">
    <div class="row-thumb"><% if (p.cover) { %><img src="/uploads/<%= p.cover %>" alt=""><% } else { %><div class="ph"><%- include('../partials/paw') %></div><% } %></div>
    <div class="row-main"><strong><%= p.title %></strong><span class="muted"><%= p.category %> · <%= fdate(p.created_at) %></span>
      <% if (!p.published) { %><span class="badge badge-soft inline">Brouillon</span><% } %></div>
    <div class="row-actions">
      <% if (p.published) { %><a class="btn btn-sm btn-ghost" href="/blog/<%= p.slug %>" target="_blank">Voir</a><% } %>
      <a class="btn btn-sm btn-ghost" href="/admin/articles/<%= p.id %>">Modifier</a>
      <form method="post" action="/admin/articles/<%= p.id %>/supprimer" data-confirm="Supprimer cet article définitivement ?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-danger">Supprimer</button></form>
    </div>
  </div>
<% }) %>
</div>
<% if (library.length) { %>
<section class="library">
  <div class="library-head">
    <div>
      <h2>📚 Articles prêts à publier</h2>
      <p class="muted">Des conseils déjà rédigés pour votre blog. Ils sont ajoutés <strong>en brouillon</strong> : vous les relisez, les adaptez si besoin, puis vous les publiez.</p>
    </div>
    <% if (library.length > 1) { %>
    <form method="post" action="/admin/articles/bibliotheque/tout" data-confirm="Ajouter les <%= library.length %> articles à votre blog, en brouillon ?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost">Tout ajouter (<%= library.length %>)</button></form>
    <% } %>
  </div>
  <div class="rows">
  <% library.forEach(a => { %>
    <div class="row row-top">
      <div class="row-main"><strong><%= a.title %></strong><span class="muted"><%= a.category %></span><p><%= a.excerpt %></p></div>
      <div class="row-actions"><form method="post" action="/admin/articles/bibliotheque/<%= a.key %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm">+ Ajouter à mon blog</button></form></div>
    </div>
  <% }) %>
  </div>
  <p class="hint">Ces textes donnent des conseils généraux et ne remplacent pas l'avis d'un vétérinaire. Relisez-les avec l'association avant publication.</p>
</section>
<% } else if (libraryTotal) { %>
<p class="hint">✅ Tous les articles prêts à publier ont déjà été ajoutés à votre blog.</p>
<% } %>
<%- include('../partials/admin-footer') %>
