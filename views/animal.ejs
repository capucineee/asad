<%- include('partials/header') %>
<% const duo = animal.is_pair && animal.name2; %>
<section class="wrap page-top">
  <a class="back" href="/animaux">← Tous les animaux</a>
  <div class="detail">
    <div class="detail-media <%= duo ? 'is-duo' : '' %>">
      <figure class="detail-photo <%= animal.distress && animal.status !== 'adopte' ? 'is-distress' : '' %>">
        <% if (animal.photo) { %><img src="/uploads/<%= animal.photo %>" alt="<%= animal.name %>">
        <% } else { %><div class="ph"><%- include('partials/paw') %></div><% } %>
        <% if (animal.status === 'adopte') { %><span class="badge badge-adopted">Adopté 🎉</span>
        <% } else if (animal.distress) { %><span class="badge badge-distress"><i></i>En détresse</span><% } %>
        <% if (duo) { %><figcaption><strong><%= animal.name %></strong> · <%= sexLabel(animal.species, animal.sex) %><%= animal.age ? ' · ' + animal.age : '' %></figcaption><% } %>
      </figure>
      <% if (duo) { %>
      <figure class="detail-photo">
        <% if (animal.photo2) { %><img src="/uploads/<%= animal.photo2 %>" alt="<%= animal.name2 %>">
        <% } else { %><div class="ph"><%- include('partials/paw') %></div><% } %>
        <figcaption><strong><%= animal.name2 %></strong> · <%= sexLabel(animal.species2, animal.sex2) %><%= animal.age2 ? ' · ' + animal.age2 : '' %></figcaption>
      </figure>
      <% } %>
    </div>
    <div class="detail-info">
      <h1><%= petName(animal) %></h1>
      <% if (duo) { %>
        <p class="duo-note">💞 <strong><%= animal.name %></strong> et <strong><%= animal.name2 %></strong> sont inséparables : ils doivent être adoptés <strong>ensemble</strong>, dans la même famille.</p>
      <% } %>
      <ul class="facts">
        <% if (!duo) { %>
          <li><%= animal.species === 'chat' ? 'Chat' : 'Chien' %></li>
          <% if (animal.sex !== 'inconnu') { %><li><%= animal.sex === 'femelle' ? 'Femelle' : 'Mâle' %></li><% } %>
          <% if (animal.age) { %><li><%= animal.age %></li><% } %>
        <% } else { %>
          <li><%= animal.name %> · <%= sexLabel(animal.species, animal.sex) %><%= animal.age ? ' · ' + animal.age : '' %></li>
          <li><%= animal.name2 %> · <%= sexLabel(animal.species2, animal.sex2) %><%= animal.age2 ? ' · ' + animal.age2 : '' %></li>
        <% } %>
        <li class="st st-<%= animal.status %>"><%= { disponible: 'Cherche une famille', reserve: 'Réservé', adopte: 'Adopté' }[animal.status] %></li>
      </ul>
      <% if (animal.distress && animal.status !== 'adopte') { %>
        <p class="alert-soft"><strong><%= duo ? 'Ces animaux sont en détresse' : 'Cet animal est en détresse' %></strong> et <%= duo ? 'ont' : 'a' %> besoin d'aide rapidement. Contactez-nous dès aujourd'hui.</p>
      <% } %>
      <div class="prose"><%- formatContent(animal.description) %></div>
      <% if (story) { %><div class="actions"><a class="btn" href="/histoires/<%= story.id %>">Lire son histoire 💛</a></div><% } %>
      <%- include('partials/share', { shareWhat: 'cette annonce', shareText: petName(animal) + (duo ? " cherchent" : " cherche") + " une famille — ASAD" }) %>
      <% if (animal.status !== 'adopte') { %>
        <div class="actions">
          <% if (settings.email) { %><a class="btn" href="mailto:<%= settings.email %>?subject=<%= encodeURIComponent('Adoption de ' + petName(animal)) %>">Je m'intéresse à <%= petName(animal) %></a><% } %>
          <% if (settings.phone) { %><a class="btn btn-ghost" href="tel:<%= settings.phone.replace(/\s/g,'') %>"><%= settings.phone %></a><% } %>
        </div>
      <% } %>
    </div>
  </div>
</section>
<%- include('partials/footer') %>
