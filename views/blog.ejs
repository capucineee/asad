<%- include('partials/header') %>
<section class="page-head"><div class="wrap">
  <h1>Le blog</h1>
  <p class="lead">Conseils, bons réflexes et nouvelles de l'association.</p>
</div></section>
<section class="section-tight"><div class="wrap">
  <% if (posts.length) { %><div class="grid grid-3"><% posts.forEach(post => { %><%- include('partials/post-card', { post }) %><% }) %></div>
  <% } else { %><p class="empty">Les premiers articles arrivent bientôt.</p><% } %>
</div></section>
<%- include('partials/footer') %>
